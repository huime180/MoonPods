<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 免 root 模式下耳机状态通知由本应用自己发 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 连接弹窗（PopupActivity）：没有这条声明时系统里根本没有悬浮窗开关，
         canDrawOverlays() 恒为 false，后台启动 Activity 也会被 BAL 拦截 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!--
        「从水月雨官方 App 导入图片」要访问 MOONDROP 的公开产品目录与图床
        （cdn-service.moondroplab.tech / cdn.moondroplab.tech）。仅此一处用网，
        不涉及任何账号或私有接口。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.moondroplab.moondrop.moondrop_app" />
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:name=".MoonPodsApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:extractNativeLibs="false"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperPods">

        <activity-alias
            android:name=".LauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|locale|mcc|navigation|smallestScreenSize|touchscreen|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity android:name=".PopupActivity"
            android:theme="@style/Theme.HyperPods.Popup"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="chen.action.hyperpods.show_pods_ui" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 免 root 模式：耳机（A2DP）连上时唤醒应用进程并直连。
             用系统广播做入口，不起前台服务、不常驻通知。 -->
        <receiver
            android:name=".noroot.NorootConnectReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".config.PodImageProvider"
            android:authorities="moe.huime.moonpods.podimages"
            android:exported="true"
            android:grantUriPermissions="false" />
        <!-- Set as Xposed Module -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <!-- Set your Xposed Module description -->
        <meta-data
            android:name="xposeddescription"
            android:value="OPPO Earphones Support for Xiaomi HyperOS." />

        <!-- The minimum Xposed version number -->
        <meta-data
            android:name="xposedminversion"
            android:value="101" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
            <service
            android:name=".noroot.NorootKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
